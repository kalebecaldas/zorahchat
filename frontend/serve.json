{
  "public": "dist",
  "rewrites": [
    { "source": "/api/**", "destination": "https://backend-chat-zorah-faturamento-iaam.up.railway.app/api/:splat" },
    { "source": "/uploads/**", "destination": "https://backend-chat-zorah-faturamento-iaam.up.railway.app/uploads/:splat" },
    { "source": "/socket.io/**", "destination": "https://backend-chat-zorah-faturamento-iaam.up.railway.app/socket.io/:splat" },
    { "source": "**", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/**",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "**/*.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    }
  ]
}
